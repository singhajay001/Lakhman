{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/app/**/*.ts",
    "apps/*/app/**/*.tsx",
    "vitest.config.ts",
    "apps/*/*.ts",
    "apps/*/src/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/build", "**/.react-router"]
}
