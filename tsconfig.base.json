{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@spirithaus/db": ["packages/db/src/index.ts"],
      "@spirithaus/domain": ["packages/domain/src/index.ts"],
      "@spirithaus/providers": ["packages/providers/src/index.ts"],
      "@spirithaus/jobs": ["packages/jobs/src/index.ts"],
      "@spirithaus/observability": ["packages/observability/src/index.ts"],
      "@spirithaus/shopify": ["packages/shopify/src/index.ts"],
      "@spirithaus/testing": ["packages/testing/src/index.ts"]
    }
  }
}
