{%- comment -%}
  SpiritHaus — homepage hero.

  Full-bleed image under an ink overlay, one heading carrying the light-against
  -black weight contrast, and a single red call to action.

  ACCESSIBILITY NOTE ON THE OVERLAY
  White type over a photograph only passes AA if the overlay is dark enough. The
  worst case is a pure-white image underneath, and compositing ink #111110 over
  white at opacity a gives 4.5:1 for white text at a = 57.3%.

  The overlay range below therefore starts at 58, not 0. An editor cannot
  configure an unreadable hero, whatever image they upload. At the 62% default
  the guaranteed floor is 5.3:1, and brighter images only improve it.
{%- endcomment -%}

<div class="sh-hero{% if section.settings.full_height %} sh-hero--tall{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="sh-hero__media">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'sh-hero__image',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 2500, 3000, 3840',
          sizes: '100vw',
          alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}

  <div
    class="sh-hero__scrim"
    style="--sh-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  ></div>

  <div class="sh-hero__content page-width">
    {%- if section.settings.kicker != blank -%}
      <p class="sh-label sh-hero__kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="sh-hero__heading sh-heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="sh-hero__body">{{ section.settings.body | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a href="{{ section.settings.cta_link }}" class="button sh-hero__cta">
        {{- section.settings.cta_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "sh-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Landscape crops work best. Leave empty for a plain ink hero."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Ink overlay",
      "unit": "%",
      "min": 58,
      "max": 90,
      "step": 2,
      "default": 62,
      "info": "Starts at 58% because below that white text can fail WCAG AA over a light image."
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Taller hero on desktop",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Spirits, wine and canned cocktails"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Three hundred and eighty bottles. <strong>Every one chosen.</strong>",
      "info": "Wrap the emphasis words in bold to carry the light-against-black contrast."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "We cannot beat the chains on price or breadth, so we do not try. Every bottle here earned its place, and we tell you why."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Browse the range"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
