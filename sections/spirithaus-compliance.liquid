{%- comment -%}
  SpiritHaus — site-wide liquor compliance notice.

  Renders in the footer group, so it appears on every page that uses the
  standard layout.

  The licence name and number are schema settings, never hardcoded. Dispatch
  currently runs through Trafalgar Supermarket & Cellars, Marsfield, which holds
  the licence and is therefore the legal seller. When SpiritHaus holds its own
  licence these two fields change in the theme editor and nothing else moves.

  The warning wording is editable for the same reason: it is reproduced here as
  the standard NSW notice, but the licensee should confirm the exact text
  required for their licence type before this goes live.
{%- endcomment -%}

<div class="sh-compliance" role="contentinfo" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="page-width sh-compliance__inner">
    {%- if section.settings.licence_name != blank -%}
      <p class="sh-compliance__licence">
        <span class="sh-label sh-compliance__key">{{ section.settings.licence_prefix | escape }}</span>
        <span class="sh-compliance__value">
          {{- section.settings.licence_name | escape -}}
          {%- if section.settings.licence_number != blank -%}
            <span class="sh-compliance__number">
              {{- section.settings.licence_number_prefix | escape }} {{ section.settings.licence_number | escape -}}
            </span>
          {%- endif -%}
        </span>
      </p>
    {%- endif -%}

    {%- if section.settings.warning != blank -%}
      <p class="sh-compliance__warning">{{ section.settings.warning | escape }}</p>
    {%- endif -%}

    {%- if section.settings.id_notice != blank -%}
      <p class="sh-compliance__id">{{ section.settings.id_notice | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Liquor compliance",
  "tag": "section",
  "class": "sh-compliance-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Appears on every page. The licence holder is the legal seller and must be named site-wide. Update these fields when SpiritHaus holds its own licence."
    },
    {
      "type": "text",
      "id": "licence_prefix",
      "label": "Licence label",
      "default": "Liquor licensee"
    },
    {
      "type": "text",
      "id": "licence_name",
      "label": "Licence holder",
      "default": "Trafalgar Supermarket & Cellars, Marsfield NSW"
    },
    {
      "type": "text",
      "id": "licence_number_prefix",
      "label": "Licence number label",
      "default": "Licence no."
    },
    {
      "type": "text",
      "id": "licence_number",
      "label": "Licence number",
      "info": "Enter the licence number exactly as issued. Leave empty and the number is omitted rather than shown blank."
    },
    {
      "type": "textarea",
      "id": "warning",
      "label": "Under-18 warning",
      "default": "It is against the law to sell or supply alcohol to, or to obtain alcohol on behalf of, a person under the age of 18 years.",
      "info": "Standard NSW wording. Confirm the exact text required for your licence type before launch."
    },
    {
      "type": "textarea",
      "id": "id_notice",
      "label": "Photo ID notice",
      "default": "Photo ID is required on delivery. Our driver will refuse to hand over an order to anyone who cannot show valid identification, or who appears intoxicated."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Landmark label",
      "default": "Liquor licensing information",
      "info": "Read by screen readers to identify this region."
    }
  ],
  "presets": [
    {
      "name": "Liquor compliance"
    }
  ]
}
{% endschema %}
