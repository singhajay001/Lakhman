{%- comment -%}
  SpiritHaus — entry-level age gate.

  SCOPE — READ THIS BEFORE RELYING ON IT
  This is an entry-level declaration, not verification. A self-declared date of
  birth is one click and proves nothing. It exists as a reasonable-steps signal
  and an industry convention. The controls that actually work are photo ID on
  delivery and checkout-level verification, which comes from a separate app.
  Do not let this gate stand in for either.

  DESIGN NOTES
  - The page renders normally underneath; this is an overlay, never a blank
    page. A gate that hides content can suppress indexing of all 380 products.
  - Cookie-based, 30 days, so search crawlers and repeat visitors are unaffected.
  - Focus-trapped and keyboard navigable. Escape deliberately does NOT dismiss
    it: escaping a gate is not a thing a gate should allow.
  - No-JS visitors are not trapped behind a dialog they cannot dismiss — the
    <noscript> rule below hides it. A gate nobody can pass is worse than none.
  - Policy pages are never gated. Terms, Privacy and Responsible Service of
    Alcohol have to be reachable without passing anything.
{%- endcomment -%}

{%- liquid
  assign show_gate = true

  unless section.settings.enable
    assign show_gate = false
  endunless

  # Shopify's own policy pages (/policies/...) are always reachable.
  if request.page_type == 'policy'
    assign show_gate = false
  endif
  if request.path contains '/policies/'
    assign show_gate = false
  endif

  # Additional pages to leave ungated, by handle.
  assign exempt = section.settings.exempt_handles | split: ','
  for handle in exempt
    assign clean = handle | strip
    if clean != blank and page.handle == clean
      assign show_gate = false
    endif
  endfor
-%}

{%- if show_gate -%}
  <noscript>
    <style>
      .sh-age-gate {
        display: none;
      }
    </style>
  </noscript>

  <div
    class="sh-age-gate"
    id="ShAgeGate"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ShAgeGateHeading"
    aria-describedby="ShAgeGateBody"
    data-cookie-days="{{ section.settings.cookie_days }}"
    data-exit-url="{{ section.settings.exit_url }}"
  >
    <div class="sh-age-gate__panel">
      <h2 class="sh-age-gate__heading sh-heading" id="ShAgeGateHeading">
        {{ section.settings.heading }}
      </h2>

      <p class="sh-age-gate__body" id="ShAgeGateBody">{{ section.settings.body | escape }}</p>

      <div class="sh-age-gate__actions">
        <button type="button" class="button sh-age-gate__confirm" data-sh-age-confirm>
          {{- section.settings.confirm_label | escape -}}
        </button>
        <button type="button" class="sh-age-gate__decline" data-sh-age-decline>
          {{- section.settings.decline_label | escape -}}
        </button>
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="sh-age-gate__footnote">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function () {
      var gate = document.getElementById('ShAgeGate');
      if (!gate) return;

      // The theme editor must not be blocked by a modal on every reload.
      if (window.Shopify && window.Shopify.designMode) {
        gate.remove();
        document.documentElement.classList.add('sh-age-verified');
        return;
      }

      var root = document.documentElement;
      var days = parseInt(gate.getAttribute('data-cookie-days'), 10) || 30;
      var COOKIE = 'sh_age_ok';

      function verified() {
        return document.cookie.split('; ').indexOf(COOKIE + '=1') !== -1;
      }

      function dismiss() {
        var expiry = new Date();
        expiry.setTime(expiry.getTime() + days * 864e5);
        document.cookie =
          COOKIE + '=1; expires=' + expiry.toUTCString() + '; path=/; SameSite=Lax' +
          (location.protocol === 'https:' ? '; Secure' : '');
        root.classList.add('sh-age-verified');
        // Both of these must be undone, or the page stays locked and unfocusable
        // after the gate itself is gone.
        root.classList.remove('sh-age-locked');
        document.removeEventListener('focusin', trapFocus);
        gate.remove();
        // Hand focus somewhere sensible rather than dropping it on <body>.
        var target = document.querySelector('.skip-to-content-link') || document.body;
        if (target.setAttribute && target === document.body) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      }

      if (verified()) {
        root.classList.add('sh-age-verified');
        gate.remove();
        return;
      }

      root.classList.add('sh-age-locked');

      gate.querySelector('[data-sh-age-confirm]').addEventListener('click', dismiss);
      gate.querySelector('[data-sh-age-decline]').addEventListener('click', function () {
        window.location.href = gate.getAttribute('data-exit-url');
      });

      // Focus trap. Escape is intentionally not handled — a gate you can escape
      // from is not a gate.
      var focusables = gate.querySelectorAll('button, [href], [tabindex]:not([tabindex="-1"])');
      var first = focusables[0];
      var last = focusables[focusables.length - 1];

      gate.addEventListener('keydown', function (event) {
        if (event.key !== 'Tab') return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      // Keep focus inside the dialog if anything else steals it. Named so that
      // dismiss() can detach it — an anonymous listener here would outlive the
      // gate and trap focus on a node no longer in the document.
      function trapFocus(event) {
        if (!gate.isConnected) return;
        if (!gate.contains(event.target) && first) first.focus();
      }
      document.addEventListener('focusin', trapFocus);

      if (first) first.focus({ preventScroll: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Age gate",
  "tag": "section",
  "class": "sh-age-gate-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Entry-level declaration only. It is not verification and does not replace photo ID on delivery or checkout-level age checks."
    },
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable age gate",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Are you over <strong>18</strong>?",
      "info": "Wrap the emphasis word in bold to carry the light-against-black weight contrast."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "You must be 18 or over to buy alcohol in Australia. Photo ID is required on delivery."
    },
    {
      "type": "text",
      "id": "confirm_label",
      "label": "Confirm button",
      "default": "Yes, I am 18 or over"
    },
    {
      "type": "text",
      "id": "decline_label",
      "label": "Decline button",
      "default": "No, I am under 18"
    },
    {
      "type": "url",
      "id": "exit_url",
      "label": "Decline destination",
      "default": "https://drinkwise.org.au",
      "info": "Where someone under 18 is sent. A useful destination, not a dead end."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "We remember your answer on this device for 30 days."
    },
    {
      "type": "range",
      "id": "cookie_days",
      "label": "Remember for",
      "unit": "d",
      "min": 1,
      "max": 90,
      "step": 1,
      "default": 30
    },
    {
      "type": "textarea",
      "id": "exempt_handles",
      "label": "Never gate these pages",
      "default": "responsible-service-of-alcohol, terms, privacy, contact",
      "info": "Page handles, comma separated. Shopify's own /policies/ pages are always exempt and do not need listing."
    }
  ],
  "presets": [
    {
      "name": "Age gate"
    }
  ]
}
{% endschema %}
