{%- comment -%}
  SpiritHaus — the curation statement.

  Type only, no image. This is the argument for the whole shop: 380 products,
  not 14,000. It is set large and given room, because it is the reason someone
  buys here rather than from a chain.

  Figures are optional blocks so the comparison can be stated as numbers without
  hardcoding them in copy.
{%- endcomment -%}

<div class="sh-curation">
  <div class="page-width sh-curation__inner">
    {%- if section.settings.kicker != blank -%}
      <p class="sh-label sh-curation__kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="sh-curation__heading sh-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="sh-curation__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <dl class="sh-curation__figures">
        {%- for block in section.blocks -%}
          <div class="sh-curation__figure" {{ block.shopify_attributes }}>
            <dt class="sh-label sh-curation__figure-label">{{ block.settings.label | escape }}</dt>
            <dd class="sh-curation__figure-value">{{ block.settings.value | escape }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Curation statement",
  "tag": "section",
  "class": "sh-curation-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Why we are different"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Three hundred and eighty. <strong>Not fourteen thousand.</strong>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>A big retailer stocks everything, which means it recommends nothing. We stock 380 bottles and we can tell you why each one is here — what it tastes like, who made it, and what it beats at the price.</p><p>If a bottle cannot earn its place on the shelf, it does not go on the shelf.</p>"
    }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "Figure",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Figure",
          "default": "380"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bottles stocked"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curation statement",
      "blocks": [
        { "type": "figure" },
        { "type": "figure" }
      ]
    }
  ]
}
{% endschema %}
