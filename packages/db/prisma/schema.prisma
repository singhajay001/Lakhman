// SPIRITHAUS Social Studio — Phase 1 schema (migrations 1–3 of the ten in
// docs/social-studio/03-data-model.md).
//
// Conventions, applied without exception:
//   * every non-global table carries shopId as the first column of its primary index
//   * status is an enum, never a string or a pair of booleans
//   * money is Decimal(12,4) with an explicit currency, never a float
//   * timestamps are stored UTC; Shop.timezone is for display only

generator client {
  // Default output (node_modules/.prisma/client), deliberately: a generated client
  // inside the package source is bundled by Rollup, which cannot read named exports
  // out of its CommonJS entry. Left external, it resolves at runtime as intended.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Migration 1 — shop, identity, audit, webhooks
// ---------------------------------------------------------------------------

model Shop {
  id             String    @id @default(cuid())
  domain         String    @unique
  name           String?
  timezone       String    @default("Australia/Sydney")
  currency       String    @default("AUD")
  /// Scopes Shopify actually granted, which is not always what was requested.
  grantedScopes  String[]  @default([])
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users        User[]
  auditEvents  AuditEvent[]
  notifications Notification[]
  products     ShopifyProduct[]
  collections  ShopifyCollection[]
  syncRuns     SyncRun[]
  providers    ProviderConfig[]
  promptTemplates PromptTemplate[]
  aiUsage      AIUsageRecord[]
  research     ProductResearch[]
  brandKit     BrandKit?
  campaigns    Campaign[]
  licences     AssetLicence[]
  protectedAssets ProtectedProductAsset[]
  mediaAssets  MediaAsset[]
  renderJobs   RenderJob[]
  voiceProfiles VoiceProfile[]
  audioAssets  AudioAsset[]

  @@map("shop")
}

/// Shopify's own session table. The shape is dictated by
/// @shopify/shopify-app-session-storage-prisma and must not be edited freely.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  /// Encrypted at the application layer before it is written (ADR 0014). Never a usable
  /// credential at rest.
  accessToken   String
  /// Written by PrismaSessionStorage 11. Absent from this model until it was exercised against
  /// the real library, which failed every storeSession with "Unknown argument `refreshToken`" —
  /// meaning OAuth could never have persisted a session. Encrypted like the access token,
  /// because a refresh token mints access tokens and is the more valuable of the two.
  refreshToken  String?
  refreshTokenExpires DateTime?
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
  @@map("session")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  shopId        String
  email         String
  name          String?
  /// Shopify staff id when the user arrived through an online session.
  shopifyUserId BigInt?
  status        UserStatus @default(ACTIVE)
  lastSeenAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  roles       UserRole[]
  auditEvents AuditEvent[] @relation("AuditActor")
  notifications Notification[]
  grantedRoles UserRole[]  @relation("RoleGrantedBy")
  promptVersions PromptVersion[]
  reviewedProviders ProviderConfig[] @relation("ProviderReviewer")

  @@unique([shopId, email])
  @@index([shopId, status])
  @@map("user")
}

/// The six roles of section 20. Global catalogue, seeded, not shop-scoped —
/// a role means the same thing in every shop.
model Role {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId      String
  roleId      String
  grantedById String?
  grantedAt   DateTime @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_role")
}

/// Append-only. A Postgres rule in migration 1 rejects UPDATE and DELETE, so an
/// audit trail cannot be rewritten by a feature nobody has written yet.
model AuditEvent {
  id          String   @id @default(cuid())
  shopId      String
  actorUserId String?
  actorRole   String?
  action      String
  targetType  String
  targetId    String?
  before      Json?
  after       Json?
  ip          String?
  requestId   String?
  createdAt   DateTime @default(now())

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([shopId, targetType, targetId])
  @@index([shopId, action, createdAt])
  @@map("audit_event")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String               @id @default(cuid())
  shopId    String
  userId    String?
  kind      String
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId, readAt, createdAt])
  @@map("notification")
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED_DUPLICATE
}

/// Shopify redelivers. The unique index is what makes replay free, and it is
/// checked before any handler side effect (section 7).
model WebhookEvent {
  id              String        @id @default(cuid())
  shopDomain      String
  topic           String
  shopifyEventId  String
  apiVersion      String?
  payload         Json
  status          WebhookStatus @default(RECEIVED)
  attempts        Int           @default(0)
  error           String?
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?

  @@unique([shopDomain, topic, shopifyEventId])
  @@index([topic, status, receivedAt])
  @@map("webhook_event")
}

// ---------------------------------------------------------------------------
// Migration 2 — the Shopify mirror
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

model ShopifyProduct {
  id               String        @id @default(cuid())
  shopId           String
  gid              String
  handle           String
  title            String
  descriptionHtml  String?
  productType      String?
  vendor           String?
  tags             String[]      @default([])
  status           ProductStatus
  featuredImageUrl String?
  onlineStoreUrl   String?
  publishedAt      DateTime?
  shopifyUpdatedAt DateTime?
  syncedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  shop        Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants    ShopifyVariant[]
  collections ShopifyCollectionProduct[]
  research    ProductResearch?
  campaigns   CampaignProduct[]
  protectedAssets ProtectedProductAsset[]

  @@unique([shopId, gid])
  @@unique([shopId, handle])
  @@index([shopId, status])
  @@index([shopId, syncedAt])
  @@map("shopify_product")
}

model ShopifyVariant {
  id                 String   @id @default(cuid())
  shopId             String
  productId          String
  gid                String
  sku                String?
  title              String
  position           Int      @default(1)
  price              Decimal  @db.Decimal(12, 4)
  compareAtPrice     Decimal? @db.Decimal(12, 4)
  currency           String   @default("AUD")
  /// inventoryItem.unitCost — COGS for contribution margin. Often empty, and the
  /// margin is labelled estimated when it is (docs/social-studio/07-attribution.md).
  unitCost           Decimal? @db.Decimal(12, 4)
  inventoryQuantity  Int      @default(0)
  inventoryPolicy    String?
  availableForSale   Boolean  @default(false)
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopId, gid])
  @@index([shopId, productId])
  @@index([shopId, availableForSale])
  @@map("shopify_variant")
}

model ShopifyCollection {
  id              String   @id @default(cuid())
  shopId          String
  gid             String
  handle          String
  title           String
  descriptionHtml String?
  sortOrder       String?
  productCount    Int      @default(0)
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop     Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products ShopifyCollectionProduct[]

  @@unique([shopId, gid])
  @@unique([shopId, handle])
  @@map("shopify_collection")
}

model ShopifyCollectionProduct {
  shopId       String
  collectionId String
  productId    String

  collection ShopifyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    ShopifyProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([shopId, productId])
  @@map("shopify_collection_product")
}

enum SyncKind {
  PRODUCTS
  COLLECTIONS
  INVENTORY
  FULL
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  /// The sync never reached Shopify: no offline session, or the host is refused by the
  /// container's egress policy. Distinct from FAILED because nothing was attempted and
  /// retrying changes nothing, and distinct from SUCCEEDED because the mirror was not updated.
  UNREACHABLE
}

model SyncRun {
  id         String     @id @default(cuid())
  shopId     String
  kind       SyncKind
  status     SyncStatus @default(RUNNING)
  trigger    String
  cursor     String?
  counts     Json       @default("{}")
  /// Populated by the reconciliation pass: what the mirror held that Shopify no
  /// longer does, and the reverse.
  reconciliation Json?
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, kind, startedAt])
  @@map("sync_run")
}

// ---------------------------------------------------------------------------
// Migration 3 — AI governance foundations (section 34)
// ---------------------------------------------------------------------------

model ProviderConfig {
  id               String   @id @default(cuid())
  shopId           String
  /// The provider contract this configures, e.g. "TextGenerationProvider".
  contract         String
  adapterId        String   @default("mock")
  enabled          Boolean  @default(false)
  /// Rate card an administrator entered, with the date and source it was read
  /// from. An unconfigured rate card yields an estimate of unknown, which blocks
  /// any operation with a ceiling rather than silently costing nothing.
  rateCard         Json?
  termsUrl         String?
  termsVersion     String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  budgets          Json?
  /// Non-secret configuration only. Credentials live in the secret manager.
  config           Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop       Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProviderReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([shopId, contract])
  @@map("provider_config")
}

model ModelRegistry {
  id        String   @id @default(cuid())
  provider  String
  model     String
  purpose   String
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([provider, model, purpose])
  @@map("model_registry")
}

model PromptTemplate {
  id          String   @id @default(cuid())
  shopId      String
  key         String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  versions PromptVersion[]

  @@unique([shopId, key])
  @@map("prompt_template")
}

model PromptVersion {
  id              String   @id @default(cuid())
  templateId      String
  version         Int
  body            String
  variables       Json     @default("[]")
  active          Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())

  template  PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  usage     AIUsageRecord[]

  @@unique([templateId, version])
  @@map("prompt_version")
}

enum ProviderOutcome {
  SUCCEEDED
  FAILED
  REFUSED_BUDGET
  REFUSED_POLICY
}

model AIUsageRecord {
  id                String          @id @default(cuid())
  shopId            String
  contract          String
  adapterId         String
  model             String?
  promptVersionId   String?
  /// Set once campaigns exist (migration 5). Kept nullable rather than absent so
  /// Phase 1 usage is still attributable later.
  campaignId        String?
  assetId           String?
  units             Json            @default("{}")
  estimatedCostAud  Decimal?        @db.Decimal(12, 4)
  actualCostAud     Decimal?        @db.Decimal(12, 4)
  providerRequestId String?
  latencyMs         Int?
  outcome           ProviderOutcome
  errorClass        String?
  createdAt         DateTime        @default(now())

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([shopId, contract, createdAt])
  @@index([shopId, campaignId])
  @@map("ai_usage_record")
}

// ---------------------------------------------------------------------------
// Migration 4 — research and the Brand Kit (sections 9 and 14)
// ---------------------------------------------------------------------------

enum ResearchStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model ProductResearch {
  id        String         @id @default(cuid())
  shopId    String
  /// One research record per product, enforced as a single-field unique because the
  /// relation is one-to-one.
  productId String         @unique
  status    ResearchStatus @default(DRAFT)
  /// Free-text notes from the reviewer. Never used as a source of fact.
  notes     String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  shop    Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product ShopifyProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  claims  ResearchClaim[]
  sources ResearchSource[]

  @@index([shopId, status])
  @@map("product_research")
}

enum ClaimKind {
  VERIFIED
  INFERRED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  /// Two sources disagree. Section 9 forbids resolving a conflict without review.
  CONFLICTED
}

/// One attribute of a product, with where it came from and how sure we are.
/// Only an APPROVED claim may enter promotional content.
model ResearchClaim {
  id         String      @id @default(cuid())
  shopId     String
  researchId String
  /// "abv", "region", "age_statement", "award", "tasting_note_palate", …
  field      String
  value      String
  kind       ClaimKind   @default(VERIFIED)
  status     ClaimStatus @default(PENDING)
  /// 0–1. Reported, never used to auto-approve.
  confidence Decimal     @db.Decimal(3, 2)
  sourceId   String?
  /// Set when this claim contradicts another; both are surfaced.
  conflictsWithId  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  research ProductResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  source   ResearchSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([shopId, researchId, status])
  @@index([shopId, field])
  @@map("research_claim")
}

model ResearchSource {
  id          String   @id @default(cuid())
  shopId      String
  researchId  String
  url         String
  publisher   String?
  title       String?
  retrievedAt DateTime
  /// Whether the publisher is the producer, a distributor, a trade body, or other.
  authority   String   @default("unknown")
  /// The extracted excerpt the claim was read from. Untrusted data, never instructions.
  excerpt     String?
  createdAt   DateTime @default(now())

  research ProductResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  claims   ResearchClaim[]

  @@index([shopId, researchId])
  @@map("research_source")
}

model BrandKit {
  id               String   @id @default(cuid())
  shopId           String   @unique
  currentVersionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  versions BrandKitVersion[]

  @@map("brand_kit")
}

/// Immutable. A published version is never edited; a change creates the next one, so
/// the exact Brand Kit an asset was made under can always be resolved (section 14).
model BrandKitVersion {
  id         String   @id @default(cuid())
  shopId     String
  brandKitId String
  version    Int
  /// Tokens, tone, vocabulary, prohibited phrases, CTA patterns, responsible-service
  /// wording, business details. Seeded from docs/spirithaus/theme-profile.json rather
  /// than typed in, so the storefront and the social output are provably one brand.
  content    Json
  /// Fields an administrator must confirm before the kit is usable. Section 14 forbids
  /// inventing missing brand details, so they are seeded as marked placeholders.
  placeholders String[] @default([])
  note       String?
  publishedByUserId String?
  publishedAt DateTime @default(now())

  brandKit BrandKit   @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([brandKitId, version])
  @@index([shopId])
  @@map("brand_kit_version")
}

// ---------------------------------------------------------------------------
// Migration 5 — campaigns and content (sections 11, 12, 13)
// ---------------------------------------------------------------------------

enum CampaignObjective {
  PRODUCT_AWARENESS
  LAUNCH
  SALES_CONVERSION
  COLLECTION_PROMOTION
  LIMITED_TIME_OFFER
  BACK_IN_STOCK
  CLEARANCE
  PREMIUM_STORYTELLING
  GIFTING
  COCKTAIL_INSPIRATION
  FOOD_PAIRING
  EDUCATION
  ENGAGEMENT
  ORGANIC_GROWTH
  PAID_CREATIVE
  RETARGETING
  SEASONAL
}

enum CampaignState {
  DRAFT
  RESEARCH_REVIEW
  COMPLIANCE_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  PAUSED
  ARCHIVED
}

model Campaign {
  id        String            @id @default(cuid())
  shopId    String
  name      String
  objective CampaignObjective
  state     CampaignState     @default(DRAFT)
  /// Recorded so a campaign can be re-read against the brand rules it was built under.
  brandKitVersionId String?
  /// Set only when an authorised user records an awareness objective, which is the one
  /// documented exception to the metric ranking in section 26.
  awarenessObjectiveApprovedBy String?
  landingUrl String?
  offerTerms String?
  expiresAt  DateTime?
  createdByUserId String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  brandKitVersion BrandKitVersion?  @relation(fields: [brandKitVersionId], references: [id], onDelete: SetNull)
  products        CampaignProduct[]
  brief           CampaignBrief?
  variants        ContentVariant[]
  approvals       Approval[]
  complianceChecks ComplianceCheck[]

  @@index([shopId, state, updatedAt])
  @@map("campaign")
}

model CampaignProduct {
  campaignId String
  productId  String
  shopId     String
  /// The product snapshot taken when the campaign was built: title, price, compare-at,
  /// availability, URL. Preflight compares against it before publication.
  snapshot   Json

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([shopId, productId])
  @@map("campaign_product")
}

model CampaignBrief {
  id         String   @id @default(cuid())
  shopId     String
  campaignId String   @unique
  /// The strategy of section 11: audience, exclusions, key message, proposition,
  /// creative concept, story angle, visual direction, pillars, CTA, keywords,
  /// hashtags, tests, metrics, compliance notes.
  strategy   Json
  /// Every approved claim the strategy and copy may draw on, frozen at generation
  /// time. Copy is checked against this, not against the live research.
  factSheet  Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_brief")
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  X
  TIKTOK
  YOUTUBE
  PINTEREST
}

enum ApprovalState {
  UNSUBMITTED
  PENDING
  APPROVED
  /// Set by a database trigger the moment a material field changes. Section 20.
  INVALIDATED
  REJECTED
}

model ContentVariant {
  id         String         @id @default(cuid())
  shopId     String
  campaignId String
  platform   SocialPlatform
  /// The platform-shaped copy: hooks, caption variants, hashtags, alt text, script,
  /// shot list, on-screen text — whatever that platform takes.
  content    Json
  /// Denormalised for the trigger: the caption the reader sees. A change here must
  /// invalidate approval, and a trigger cannot read inside a Json column reliably.
  primaryCopy String
  callToAction String?
  hashtags    String[]      @default([])
  altText     String?
  destinationUrl String?
  /// sha256 over the canonicalised variant. Computed in the application; the trigger
  /// clears it when a material field changes so a stale hash cannot match.
  contentHash String?
  approvalState ApprovalState @default(UNSUBMITTED)
  /// Incremented by the trigger on every material edit.
  revision    Int           @default(1)
  /// Which model and prompt made it (section 34).
  generation  Json?
  /// The explainable score set of section 13. Reasons included; never a forecast.
  qualityScores Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  campaign  Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approvals Approval[]
  checks    ComplianceCheck[]
  similarity ContentSimilarityRecord[]

  @@unique([campaignId, platform])
  @@index([shopId, approvalState])
  @@map("content_variant")
}

/// Perceptual and copy similarity, for the near-duplicate prevention of section 24.
/// Populated from Phase 2 for copy; media hashes join it in Phase 3.
model ContentSimilarityRecord {
  id        String         @id @default(cuid())
  shopId    String
  variantId String
  kind      String
  /// 64-bit simhash of the copy, stored as bytes with four indexed buckets so a
  /// candidate search does not scan every asset ever published.
  hash      Bytes
  bucket0   Int
  bucket1   Int
  bucket2   Int
  bucket3   Int
  createdAt DateTime       @default(now())

  variant ContentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([shopId, kind, bucket0])
  @@index([shopId, kind, bucket1])
  @@index([shopId, kind, bucket2])
  @@index([shopId, kind, bucket3])
  @@map("content_similarity_record")
}

// ---------------------------------------------------------------------------
// Migration 6 — compliance and approvals (sections 20 and 32)
// ---------------------------------------------------------------------------

enum CheckSeverity {
  BLOCKING
  ADVISORY
  INFO
}

enum CheckOutcome {
  PASS
  FAIL
  NOT_APPLICABLE
}

/// One rule, one result, with its evidence. Section 32 requires rule, severity,
/// evidence, explanation, suggested correction, and the reviewer's decision.
model ComplianceCheck {
  id         String        @id @default(cuid())
  shopId     String
  campaignId String
  variantId  String?
  ruleId     String
  ruleVersion String
  category   String
  severity   CheckSeverity
  outcome    CheckOutcome
  explanation String
  evidence   Json?
  suggestion String?
  /// A reviewer may accept a blocking finding as an exception, which requires two
  /// keys and is recorded on the Approval.
  reviewerDecision String?
  reviewedByUserId String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant  ContentVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([shopId, campaignId, outcome])
  @@index([shopId, severity, outcome])
  @@map("compliance_check")
}

enum ApprovalKind {
  ORGANIC_PUBLICATION
  HIGH_RISK_CONTENT
  PAID_BUDGET
  BUDGET_SCALING
  COMPETITION
  COMPLIANCE_EXCEPTION
}

enum ApprovalOutcome {
  PENDING
  GRANTED
  REJECTED
  /// The content changed after approval. Section 20.
  INVALIDATED
}

model Approval {
  id         String          @id @default(cuid())
  shopId     String
  campaignId String
  variantId  String?
  kind       ApprovalKind
  /// Computed from the action and the budget at creation, never chosen by the
  /// requester. Two for paid above threshold, competitions and exceptions.
  requiredKeys Int           @default(1)
  outcome    ApprovalOutcome @default(PENDING)
  /// sha256 over the canonicalised content this approval is for. A variant whose hash
  /// no longer matches is not approved, whatever this row says.
  contentHash String
  /// Everything section 20 requires recorded: destinations, audience segment and its
  /// version, schedule window, budget, compliance result, product snapshot, Brand Kit
  /// version, prompt and model versions.
  context    Json
  budgetAud  Decimal?        @db.Decimal(12, 2)
  scheduledFrom DateTime?
  scheduledTo   DateTime?
  requestedByUserId String?
  decidedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant  ContentVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  keys     ApprovalKey[]

  @@index([shopId, outcome, createdAt])
  @@map("approval")
}

/// One human, one key. The unique index on (approvalId, userId) is what stops one
/// person satisfying both halves of a dual-control action.
model ApprovalKey {
  id         String   @id @default(cuid())
  shopId     String
  approvalId String
  userId     String
  /// 1 or 2. A check constraint in the migration enforces the range.
  keyIndex   Int
  role       String
  /// What the approver saw when they signed: the hash at the moment of signing.
  signedHash String
  note       String?
  signedAt   DateTime @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@unique([approvalId, userId])
  @@unique([approvalId, keyIndex])
  @@index([shopId, userId])
  @@map("approval_key")
}

// ---------------------------------------------------------------------------
// Migration 7 — protected media (sections 15, 16, 17)
// ---------------------------------------------------------------------------

enum AssetLicenceKind {
  OWNED
  COMMISSIONED
  LICENSED
  OPEN_FONT
}

/// No licence, no ingestion. Section 16 requires music and imagery rights recorded.
model AssetLicence {
  id           String           @id @default(cuid())
  shopId       String
  kind         AssetLicenceKind
  holder       String
  terms        String
  permittedUses String[]        @default([])
  expiresAt    DateTime?
  evidenceUrl  String?
  createdAt    DateTime         @default(now())

  shop     Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products ProtectedProductAsset[]
  media    MediaAsset[]

  @@index([shopId, expiresAt])
  @@map("asset_licence")
}

enum ProtectedAssetStatus {
  INGESTED
  MASKED
  APPROVED
  RETIRED
}

/// The immutable product truth asset of section 15.
model ProtectedProductAsset {
  id          String               @id @default(cuid())
  shopId      String
  productId   String?
  licenceId   String
  status      ProtectedAssetStatus @default(INGESTED)
  /// Object key of the original photograph, unmodified.
  masterKey   String
  /// sha256 of the original bytes. Write-once after approval, enforced by trigger.
  masterDigest String
  widthPx     Int
  heightPx    Int
  /// Mean Lab of the label on the approved master, recorded once at ingestion.
  colourReference Json?
  /// Minimum resolution this asset may be used at, so a low-resolution master cannot be
  /// scaled into a hero.
  minUsableWidthPx Int            @default(0)
  /// Set when this asset is a rendition of another at a smaller size. Resampling happens once,
  /// deliberately and recorded, rather than inside every composite — because at a downscale
  /// three of the four protection checks stop being decisive.
  renditionOfId   String?
  /// Where the master came from, when it was ingested from a catalogue rather than uploaded.
  /// The CDN URL with every sizing transform stripped, so it names the original.
  sourceUrl       String?
  /// Which source produced it, in the source's own words. Never inferred: a storefront read is
  /// never recorded as an Admin read.
  sourceKind      String?
  /// What the subject measured as: aspect, fill, and the column-profile separation that says
  /// whether this packshot shows one product or a bottle beside its gift box.
  subjectProfile  Json?
  /// What the cutout step did, or why it declined to do anything.
  cutout          Json?
  /// The label text OCR read on the master at ingestion, with the catalogue values it was
  /// checked against. This is the ground truth later reads are compared to.
  groundTruth     Json?
  /// Set when something about this asset needs a person to look before it is staged. An asset
  /// may be ingested and still not be fit to use.
  needsReview     Boolean              @default(false)
  reviewReasons   String[]             @default([])
  approvedByUserId String?
  approvedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  shop    Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product ShopifyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  licence AssetLicence    @relation(fields: [licenceId], references: [id])
  masks   AssetMask[]
  derived MediaAsset[]
  renditionOf ProtectedProductAsset?  @relation("Renditions", fields: [renditionOfId], references: [id], onDelete: Cascade)
  renditions  ProtectedProductAsset[] @relation("Renditions")

  @@index([shopId, status])
  @@index([renditionOfId, widthPx])
  /// The same artwork is ingested once. A second sync finds the row rather than making another.
  @@unique([shopId, masterDigest])
  @@map("protected_product_asset")
}

enum MaskKind {
  PRODUCT
  LABEL
}

/// Two masks, not one: they answer different questions (section 15).
model AssetMask {
  id        String   @id @default(cuid())
  shopId    String
  assetId   String
  kind      MaskKind
  /// Object key of the single-channel mask PNG.
  maskKey   String
  /// sha256 of the mask bytes. Write-once once the asset is approved.
  regionDigest String
  /// Normalised bounds, for cropping the label region without decoding the mask.
  bounds    Json
  /// Pixels the inpainting mask was dilated by, so the generator cannot feather across the
  /// silhouette. Two to four; below two a halo appears at the edge.
  dilatePx  Int      @default(3)
  version   Int      @default(1)
  createdAt DateTime @default(now())

  asset ProtectedProductAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind, version])
  @@index([shopId, assetId])
  @@map("asset_mask")
}

enum MediaKind {
  COMPOSITE_STILL
  ENVIRONMENT
  VIDEO
  AUDIO
  MASK_PREVIEW
  DIFF_OVERLAY
}

enum MediaVerification {
  PENDING
  PASSED
  FAILED
  INCOMPLETE
  NOT_APPLICABLE
}

model MediaAsset {
  id           String            @id @default(cuid())
  shopId       String
  campaignId   String?
  variantId    String?
  sourceAssetId String?
  licenceId    String?
  kind         MediaKind
  objectKey    String
  contentType  String
  widthPx      Int?
  heightPx     Int?
  durationMs   Int?
  bytes        Int?
  /// The tuple the composite is reproducible from: master, mask, environment, transform.
  compositeSpec Json?
  /// The four-part verification result of section 15.
  verification MediaVerification @default(PENDING)
  verificationReport Json?
  /// Which model and prompt produced the environment, if any (section 34).
  generation   Json?
  /// Per-platform geometry readings, per delivered viewport.
  geometry     Json?
  approvedByUserId String?
  approvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  shop        Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sourceAsset ProtectedProductAsset? @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  licence     AssetLicence?          @relation(fields: [licenceId], references: [id], onDelete: SetNull)
  renderJobs  RenderJob[]

  @@index([shopId, kind, createdAt])
  @@index([shopId, verification])
  @@index([shopId, campaignId])
  @@map("media_asset")
}

enum RenderState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// What kind of visual work a job is. Compositing and video rendering have the same lifecycle —
/// queued, running, progress, cancellable, ending in a MediaAsset — so they share a table rather
/// than duplicating one.
enum MediaJobKind {
  VIDEO_RENDER
  COMPOSITE
}

/// A durable render (section 36): progress, cancellation, retry, cost, and recovery after a
/// worker restart. Never dependent on an open browser.
model RenderJob {
  id            String      @id @default(cuid())
  shopId        String
  kind          MediaJobKind @default(VIDEO_RENDER)
  campaignId    String?
  variantId     String?
  mediaAssetId  String?
  compositionId String
  props         Json
  state         RenderState @default(QUEUED)
  progress      Int         @default(0)
  attempts      Int         @default(0)
  /// Shown before the work starts, per section 37.
  estimatedCostAud Decimal? @db.Decimal(12, 4)
  actualCostAud    Decimal? @db.Decimal(12, 4)
  renderMs      Int?
  error         String?
  /// Idempotency key, unique per shop: a retry cannot start a second render of the same thing.
  idempotencyKey String
  requestedByUserId String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  media MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, state, createdAt])
  @@index([shopId, kind, state])
  @@map("render_job")
}

enum VoiceKind {
  LICENSED_SYNTHETIC
  CLONED
}

enum ConsentState {
  GRANTED
  WITHDRAWN
  EXPIRED
}

/// Section 17. Cloning is disabled by default and requires a consent record that names the
/// owner, the evidence, the permitted uses and the expiry.
model VoiceProfile {
  id          String    @id @default(cuid())
  shopId      String
  provider    String
  providerVoiceId String
  name        String
  kind        VoiceKind @default(LICENSED_SYNTHETIC)
  /// Whether this voice may be used for new generations right now.
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  consents VoiceConsent[]
  audio    AudioAsset[]

  @@unique([shopId, provider, providerVoiceId])
  @@map("voice_profile")
}

model VoiceConsent {
  id            String       @id @default(cuid())
  shopId        String
  voiceProfileId String
  /// Who the voice belongs to. A cloned voice without this cannot exist.
  ownerName     String
  ownerContact  String?
  evidenceUrl   String
  identityVerifiedBy String?
  permittedUses String[]     @default([])
  state         ConsentState @default(GRANTED)
  grantedAt     DateTime     @default(now())
  expiresAt     DateTime?
  /// Withdrawal blocks new generations. It does not erase the audit record.
  withdrawnAt   DateTime?
  withdrawnReason String?

  voiceProfile VoiceProfile @relation(fields: [voiceProfileId], references: [id], onDelete: Cascade)

  @@index([shopId, state])
  @@map("voice_consent")
}

model AudioAsset {
  id           String   @id @default(cuid())
  shopId       String
  voiceProfileId String?
  objectKey    String
  contentType  String
  durationMs   Int?
  text         String?
  /// Word-level alignment, which is what drives the caption track.
  alignment    Json?
  licenceId    String?
  createdAt    DateTime @default(now())

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  voiceProfile VoiceProfile? @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@map("audio_asset")
}
