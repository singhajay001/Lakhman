# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Phase 2 (content engine) runs end to end with every value below left blank.

# --- Google Places API (New) -------------------------------------------------
# console.cloud.google.com -> APIs & Services -> enable "Places API (New)"
# -> Credentials -> create API key -> restrict to Places API (New).
GOOGLE_MAPS_API_KEY=

# --- Google Business Profile APIs (OAuth, Phase 5) ---------------------------
# Only needed for PUBLISH_MODE=api. See README "GBP API access".
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# --- Optional paid SERP provider for map-pack ranks --------------------------
# Only read by RankProvider="serpapi". Leave blank to use the Places provider.
SERPAPI_KEY=

# --- Behaviour ---------------------------------------------------------------
# file = write captions/CSVs for manual paste (default, always safe)
# api  = publish through the GBP API (requires approved localPosts access)
PUBLISH_MODE=file

# fixture = never touch the network, replay tests/fixtures
# cache   = use data/cache when warm, network on miss
# live    = always network
API_MODE=cache

# Hard stops for the rank scanner.
MAX_CALLS_PER_SCAN=400
COST_CEILING_USD=15.00

# Which RankProvider implementation to use: places | serpapi | fixture
RANK_PROVIDER=fixture
