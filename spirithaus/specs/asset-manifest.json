{
  "campaign": "SPIRITHAUS",
  "version": "1.0.0",
  "colorSpace": "sRGB",
  "master": "16-bit, unsharpened",
  "webDelivery": { "format": "jpeg", "quality": 90, "progressive": true },
  "safeZones": {
    "hero": {
      "region": "left-third",
      "rule": "x = 0 to 0.3333 of width, full height. Empty, unlit, no objects, no specular highlights.",
      "maxLuma": "15 IRE"
    },
    "tile": {
      "region": "centre-third-band",
      "rule": "y = 0.3333 to 0.6667 of height, full width. Empty, low contrast, visual interest at top and bottom edges.",
      "maxLuma": "15 IRE"
    },
    "lifestyle": { "region": "none", "rule": "Keep one quadrant quiet for caption placement." }
  },
