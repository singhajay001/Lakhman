+                      <div class="sh-why__body">
+                        {%- comment -%}
+                          Multi-line metafield: escape first, then split, so a
+                          stray angle bracket in the copy cannot inject markup.
+                        {%- endcomment -%}
+                        {%- assign paragraphs = why | escape | split: '
+' -%}
+                        {%- for paragraph in paragraphs -%}
+                          {%- unless paragraph == blank -%}
+                            <p>{{ paragraph }}</p>
+                          {%- endunless -%}
+                        {%- endfor -%}
+                      </div>
+                    </div>
+                  {%- endif -%}
+
+                {%- when 'delivery_estimate' -%}
