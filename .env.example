# SPIRITHAUS Social Studio — environment. Copy to .env and fill in.
# No secret belongs in this file or in the repository.

# --- Shopify ------------------------------------------------------------------
# From your Partner Dashboard. `shopify app config link` writes the client id into
# shopify.app.toml; the secret only ever lives here.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
# Pinned deliberately. Shopify deprecates versions on a schedule, and an unpinned
# client changes behaviour without a deploy.
SHOPIFY_API_VERSION=2025-07
SCOPES=read_products,read_inventory,read_orders,write_pixels,read_customer_events,read_marketing_events,write_marketing_events

# --- Data ---------------------------------------------------------------------
DATABASE_URL=postgresql://spirithaus:spirithaus@localhost:5432/spirithaus_dev?schema=public
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=spirithaus
SYNC_CONCURRENCY=2

# --- Providers ----------------------------------------------------------------
# One variable per contract. `mock` (or unset) is a supported configuration: a mocked
# provider transmits nothing, and a mocked publisher reports "not published" rather
# than a plausible success.
#
# A named adapter that this build does not implement is refused with an explanation —
# it never silently falls back to a mock.
PROVIDER_TEXT=mock
PROVIDER_RESEARCH=mock
PROVIDER_TREND=mock
PROVIDER_COPY_SCORING=mock
PROVIDER_IMAGE=mock
PROVIDER_IMAGE_EDIT=mock
PROVIDER_AVATAR=mock
PROVIDER_VOICE=mock
PROVIDER_VIDEO_GEN=mock
PROVIDER_VIDEO_RENDER=mock
PROVIDER_MODERATION=mock
PROVIDER_PUBLISHING=mock
PROVIDER_SOCIAL_ANALYTICS=mock
PROVIDER_ATTRIBUTION=mock
PROVIDER_EMAIL=mock
PROVIDER_STORAGE=mock

# Provider credentials. None are read in Phase 1; listed so that enabling a provider
# is a configuration change rather than a code change.
# ANTHROPIC_API_KEY=
# FAL_KEY=
# ELEVENLABS_API_KEY=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Operations ---------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
# PRISMA_LOG=query
# Development seed only; never set in production.
SEED_SHOP_DOMAIN=spirithaus-dev.myshopify.com
