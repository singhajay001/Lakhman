# SPIRITHAUS Social Studio — environment. Copy to .env and fill in.
# No secret belongs in this file or in the repository.

# --- Shopify ------------------------------------------------------------------
# From your Partner Dashboard. `shopify app config link` writes the client id into
# shopify.app.toml; the secret only ever lives here.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
# Pinned deliberately. Shopify deprecates versions on a schedule, and an unpinned
# client changes behaviour without a deploy.
SHOPIFY_API_VERSION=2025-07
# Scopes are not configured here. They come from mandatoryScopeList() in
# packages/shopify/src/scopes.ts, where each one is recorded with the feature that stops
# working without it. A SCOPES variable used to sit here and was read by nothing.

# --- Data ---------------------------------------------------------------------
DATABASE_URL=postgresql://spirithaus:spirithaus@localhost:5432/spirithaus_dev?schema=public
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=spirithaus
SYNC_CONCURRENCY=2

# --- Providers ----------------------------------------------------------------
# One variable per contract. `mock` (or unset) is a supported configuration: a mocked
# provider transmits nothing, and a mocked publisher reports "not published" rather
# than a plausible success.
#
# A named adapter that this build does not implement is refused with an explanation —
# it never silently falls back to a mock.
PROVIDER_TEXT=mock
PROVIDER_RESEARCH=mock
PROVIDER_TREND=mock
PROVIDER_COPY_SCORING=mock
PROVIDER_IMAGE=mock
PROVIDER_IMAGE_EDIT=mock
PROVIDER_AVATAR=mock
PROVIDER_VOICE=mock
PROVIDER_VIDEO_GEN=mock
PROVIDER_VIDEO_RENDER=mock
PROVIDER_MODERATION=mock
PROVIDER_PUBLISHING=mock
PROVIDER_SOCIAL_ANALYTICS=mock
PROVIDER_ATTRIBUTION=mock
PROVIDER_EMAIL=mock
PROVIDER_STORAGE=mock

# Provider credentials are deliberately not listed. No adapter reads one yet, and a list of
# placeholder key names reads as a checklist for a live deployment that nothing would honour.
# Each returns here when the adapter that consumes it exists.
#
# There is no Admin access token variable, and there will not be one: offline tokens are issued
# by OAuth and stored in the Session table. Nothing reads a token from the environment.

# --- Operations ---------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
# Queue prefix must match between the app and the worker, or the worker watches a queue
# nothing writes to.
# QUEUE_PREFIX=spirithaus
# COMPOSITE_CONCURRENCY=2
# RENDER_CONCURRENCY=1
# Where composites and masters are written when no object storage provider is configured.
# The local store warns that it will not survive the machine.
# MEDIA_STORE_DIR=/tmp/spirithaus-media
# Set to 1 whenever https_proxy is set: Node reads it once at startup, and without it fetch
# bypasses the proxy and an egress denial arrives looking like a rejected Shopify token.
# NODE_USE_ENV_PROXY=1
# PRISMA_LOG=query
# Development seed only; never set in production.
SEED_SHOP_DOMAIN=spirithaus-dev.myshopify.com
