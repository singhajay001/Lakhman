# Copy to .env. Never commit the real file - .env is gitignored.

# --- Anthropic --------------------------------------------------------------
# Used for the weekly narrative, and later for review replies and promo copy.
# Leave unset and the report still renders, just without the narrative.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, then message it and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Commercial assumptions -------------------------------------------------
# Confirm against the merchant agreement. Every margin figure moves with this.
UBER_COMMISSION_RATE=0.30

# --- Feature flags: anything here can be switched off without a code change --
ENABLE_SCHEDULER=true
ENABLE_TELEGRAM=true
ENABLE_LLM_NARRATIVE=true

# --- Storage ----------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/agent.db      # Postgres works unchanged
# INBOX_DIR=./data/inbox
