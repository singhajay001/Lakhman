{
  "name": "spirithaus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:generate": "pnpm --filter @spirithaus/db generate",
    "db:migrate": "pnpm --filter @spirithaus/db migrate",
    "db:seed": "pnpm --filter @spirithaus/db seed",
    "dev": "pnpm --filter @spirithaus/social-studio dev",
    "dev:worker": "pnpm --filter @spirithaus/worker dev",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm --filter @spirithaus/social-studio build",
    "sync:shopify-assets": "pnpm --filter @spirithaus/social-studio sync:shopify-assets",
    "calibrate:packshots": "pnpm --filter @spirithaus/social-studio calibrate:packshots"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^10.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  }
}
